{
  // En desarrollo la cadena de conexión vive en appsettings.Development.json.
  // En producción se define por variable de entorno: ConnectionStrings__SolarUY.
  //
  // Agente de consultas: el modelo y el timeout son públicos y van acá. La clave NO está en el
  // repo: en desarrollo vive en user secrets y en el servidor en una variable de entorno.
  "Gemini": {
    "Modelo": "gemini-3.5-flash",
    "TimeoutSegundos": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
