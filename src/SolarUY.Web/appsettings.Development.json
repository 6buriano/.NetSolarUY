{
  "ConnectionStrings": {
    // Credenciales locales del MySQL que levanta docker-compose.yml en la raíz del repo.
    "SolarUY": "Server=localhost;Port=3306;Database=solareuy;User=solareuy;Password=solareuy;"
  },
  // A dónde le pregunta la pantalla de Diagnóstico el inventario al simulador. Es una herramienta
  // de desarrollo: en producción no existe.
  "Simulador": {
    "UrlBase": "http://localhost:5100"
  },
  // Servidor MCP que expone las herramientas del agente. Con dotnet run en el host es el puerto
  // local del servidor MCP; en Docker es http://mcp:8080/mcp (el servicio del compose).
  "Mcp": {
    "UrlServidor": "http://localhost:5099/mcp"
  },
  "Keycloak": {
    "Authority": "https://auth.fabriq.uy/realms/SolarUy",
    "ClientId": "solaruy-web"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
