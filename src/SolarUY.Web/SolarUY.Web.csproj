<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\SolarUY.Application\SolarUY.Application.csproj" />
    <ProjectReference Include="..\SolarUY.Domain\SolarUY.Domain.csproj" />
    <ProjectReference Include="..\SolarUY.Infrastructure\SolarUY.Infrastructure.csproj" />
  </ItemGroup>

  <!--
    Las herramientas de EF Core (dotnet ef) exigen el paquete Design en el proyecto de arranque,
    que es este. PrivateAssets="all" evita que se propague como dependencia del proyecto Web.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.20">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
