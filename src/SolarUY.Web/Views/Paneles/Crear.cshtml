@model PanelFormViewModel
@{
    ViewData["Title"] = "Nuevo panel";
}

<h1 class="h3 mb-3">Nuevo panel</h1>

@if (Model.Nodos.Count == 0)
{
    <div class="alert alert-warning">
        Para crear un panel primero tiene que existir al menos un nodo.
        <a asp-controller="Nodos" asp-action="Crear" class="alert-link">Crear un nodo</a>.
    </div>
}
else
{
    <div class="row">
        <div class="col-lg-9">
            <form asp-action="Crear" method="post" class="card card-body shadow-sm">
                <partial name="_Formulario" model="Model" />
                <div class="mt-2">
                    <button type="submit" class="btn btn-primary">Guardar</button>
                    <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
