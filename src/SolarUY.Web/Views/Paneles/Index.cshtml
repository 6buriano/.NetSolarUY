@model PanelesIndexViewModel
@{
    ViewData["Title"] = "Paneles";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Paneles</h1>
    <a class="btn btn-primary" asp-action="Crear" asp-route-nodoId="@Model.NodoId">Nuevo panel</a>
</div>

<form method="get" asp-action="Index" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label asp-for="NodoId" class="form-label">Nodo</label>
        <select asp-for="NodoId" asp-items="@(new SelectList(Model.Nodos, nameof(NodoDto.Id), nameof(NodoDto.Nombre)))" class="form-select">
            <option value="">Todos los nodos</option>
        </select>
    </div>
    <div class="col-auto">
        <label asp-for="Estado" class="form-label"></label>
        <select asp-for="Estado" asp-items="Html.GetEnumSelectList<EstadoSalud>()" class="form-select">
            <option value="">Todos los estados</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Filtrar</button>
        <a class="btn btn-link" asp-action="Index">Limpiar</a>
    </div>
</form>

@if (Model.Paneles.Count == 0)
{
    <div class="alert alert-info">
        No hay paneles para mostrar. Creá uno con el botón <strong>Nuevo panel</strong>.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Modelo</th>
                    <th>Fabricante</th>
                    <th class="text-end">Potencia nominal (W)</th>
                    <th>Estado</th>
                    <th>Nodo</th>
                    <th>Instalación</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var panel in Model.Paneles)
                {
                    <tr>
                        <td>@panel.CodigoPanel</td>
                        <td>@panel.Modelo</td>
                        <td>@panel.Fabricante</td>
                        <td class="text-end">@panel.PotenciaNominalW.ToString("0.##")</td>
                        <td>
                            <span class="badge @EstadoSaludHelper.ClaseBadge(panel.Estado)">@panel.Estado</span>
                            @if (!panel.Activo)
                            {
                                <span class="badge text-bg-secondary">Inactivo</span>
                            }
                        </td>
                        <td>@(panel.NodoNombre ?? "—")</td>
                        <td>@panel.FechaInstalacion.ToString("dd/MM/yyyy")</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Detalle" asp-route-id="@panel.Id">Ver</a>
                            <a class="btn btn-sm btn-outline-primary" asp-action="Editar" asp-route-id="@panel.Id">Editar</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Eliminar" asp-route-id="@panel.Id">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
