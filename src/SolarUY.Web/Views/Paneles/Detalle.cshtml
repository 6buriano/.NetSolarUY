@model PanelDetalleViewModel
@{
    ViewData["Title"] = Model.Panel.Modelo;
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h1 class="h3 mb-0">@Model.Panel.Modelo</h1>
        <p class="text-muted mb-0">
            @Model.Panel.Fabricante
            @if (Model.Panel.NodoNombre is not null)
            {
                <span>&middot;</span>
                <a asp-controller="Nodos" asp-action="Detalle" asp-route-id="@Model.Panel.NodoId">@Model.Panel.NodoNombre</a>
            }
        </p>
    </div>
    <div class="text-nowrap">
        <a class="btn btn-outline-primary" asp-action="Editar" asp-route-id="@Model.Panel.Id">Editar</a>
        <a class="btn btn-outline-danger" asp-action="Eliminar" asp-route-id="@Model.Panel.Id">Eliminar</a>
    </div>
</div>

<div class="card card-body shadow-sm mb-4">
    <dl class="row mb-0">
        <dt class="col-sm-4">Código de panel</dt>
        <dd class="col-sm-8"><code>@Model.Panel.CodigoPanel</code></dd>

        <dt class="col-sm-4">Potencia nominal</dt>
        <dd class="col-sm-8">@Model.Panel.PotenciaNominalW.ToString("0.##") W</dd>

        <dt class="col-sm-4">Estado de salud</dt>
        <dd class="col-sm-8"><span class="badge @EstadoSaludHelper.ClaseBadge(Model.Panel.Estado)">@Model.Panel.Estado</span></dd>

        <dt class="col-sm-4">Habilitado en el hardware</dt>
        <dd class="col-sm-8">
            @if (Model.Panel.Activo)
            {
                <span class="badge text-bg-success">Activo</span>
            }
            else
            {
                <span class="badge text-bg-secondary">Inactivo</span>
            }
            <form class="d-inline" asp-action="Desactivar" asp-route-id="@Model.Panel.Id" method="post">
                <button type="submit" class="btn btn-sm btn-outline-secondary ms-2" @(Model.Panel.Activo ? "" : "disabled")>
                    Desactivar
                </button>
            </form>
            <form class="d-inline" asp-action="Activar" asp-route-id="@Model.Panel.Id" method="post">
                <button type="submit" class="btn btn-sm btn-outline-success ms-1" @(Model.Panel.Activo ? "disabled" : "")>
                    Activar
                </button>
            </form>
        </dd>

        <dt class="col-sm-4">Fecha de instalación</dt>
        <dd class="col-sm-8">@Model.Panel.FechaInstalacion.ToString("dd/MM/yyyy")</dd>
    </dl>
</div>

<h2 class="h5">Última lectura de telemetría</h2>

@if (Model.UltimaLectura is null)
{
    <div class="alert alert-info">
        Este panel todavía no tiene lecturas. Las mide el sensor, y las guarda el colector
        (<code>SolarUY.Collector</code>) cuando le pregunta al simulador.
    </div>
}
else
{
    <div class="card card-body shadow-sm">
        <dl class="row mb-0">
            <dt class="col-sm-4">Fecha y hora</dt>
            <dd class="col-sm-8">@HoraLocal.DesdeUtc(Model.UltimaLectura.FechaHora).ToString("dd/MM/yyyy HH:mm:ss")</dd>

            <dt class="col-sm-4">Corriente continua</dt>
            <dd class="col-sm-8">@Model.UltimaLectura.CorrienteContinua.ToString("0.##") A</dd>

            <dt class="col-sm-4">Voltaje</dt>
            <dd class="col-sm-8">@Model.UltimaLectura.Voltaje.ToString("0.##") V</dd>

            <dt class="col-sm-4">Potencia generada</dt>
            <dd class="col-sm-8">@Model.UltimaLectura.PotenciaGeneradaWatts.ToString("0.##") W</dd>

            <dt class="col-sm-4">Temperatura</dt>
            <dd class="col-sm-8">@Model.UltimaLectura.TemperaturaCelsius.ToString("0.##") °C</dd>

            <dt class="col-sm-4">Estado detectado</dt>
            <dd class="col-sm-8">
                <span class="badge @EstadoSaludHelper.ClaseBadge(Model.UltimaLectura.EstadoDetectado)">@Model.UltimaLectura.EstadoDetectado</span>
            </dd>
        </dl>
    </div>

    <p class="text-muted small mt-2">
        Regla de estado (spec del simulador, sección 9): el panel queda en <code>DESCONECTADO</code> si está
        inactivo, en <code>FALLA_DETECTADA</code> si supera los 75 °C, y si no se compara su rendimiento con
        el promedio de los otros paneles activos del nodo: hasta 15 % de caída sigue operativo, más de 15 %
        es rendimiento bajo y más de 40 % es falla.
    </p>

    <h2 class="h5 mt-4">Últimas @Model.LecturasRecientes.Count lecturas</h2>
    <p class="text-muted small">
        Es lo que fue guardando el colector, de la más nueva a la más vieja. Las filas en rojo son lecturas
        en falla y en amarillo, rendimiento bajo. Las horas están en @HoraLocal.Etiqueta.
    </p>

    <div class="table-responsive">
        <table class="table table-sm table-striped align-middle">
            <thead>
                <tr>
                    <th>Fecha y hora</th>
                    <th class="text-end">Corriente (A)</th>
                    <th class="text-end">Voltaje (V)</th>
                    <th class="text-end">Potencia (W)</th>
                    <th class="text-end">Temperatura (°C)</th>
                    <th>Estado detectado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var lectura in Model.LecturasRecientes)
                {
                    var claseFila = lectura.EstadoDetectado switch
                    {
                        EstadoSalud.FALLA_DETECTADA => "table-danger",
                        EstadoSalud.RENDIMIENTO_BAJO => "table-warning",
                        _ => string.Empty
                    };

                    <tr class="@claseFila">
                        <td>@HoraLocal.DesdeUtc(lectura.FechaHora).ToString("dd/MM/yyyy HH:mm:ss")</td>
                        <td class="text-end">@lectura.CorrienteContinua.ToString("0.##")</td>
                        <td class="text-end">@lectura.Voltaje.ToString("0.##")</td>
                        <td class="text-end">@lectura.PotenciaGeneradaWatts.ToString("0.##")</td>
                        <td class="text-end">@lectura.TemperaturaCelsius.ToString("0.##")</td>
                        <td><span class="badge @EstadoSaludHelper.ClaseBadge(lectura.EstadoDetectado)">@lectura.EstadoDetectado</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<a class="btn btn-link px-0" asp-action="Index">&laquo; Volver a paneles</a>
