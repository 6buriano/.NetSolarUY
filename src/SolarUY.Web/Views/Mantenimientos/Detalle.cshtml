@model MantenimientoDto
@{
    ViewData["Title"] = "Tarea de mantenimiento";
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h1 class="h3 mb-0">@Model.Tipo</h1>
        <p class="text-muted mb-0">@(Model.PanelDescripcion ?? "Panel eliminado")</p>
    </div>
    <div class="text-nowrap">
        @if (Model.Estado != EstadoMantenimiento.COMPLETADO && Model.Estado != EstadoMantenimiento.CANCELADO)
        {
            <a class="btn btn-outline-primary" asp-action="Editar" asp-route-id="@Model.Id">Reprogramar</a>
        }
    </div>
</div>

<div class="card card-body shadow-sm mb-4">
    <dl class="row mb-0">
        <dt class="col-sm-3">Estado</dt>
        <dd class="col-sm-9"><span class="badge @EstadoMantenimientoHelper.ClaseBadge(Model.Estado)">@Model.Estado</span></dd>

        <dt class="col-sm-3">Fecha programada</dt>
        <dd class="col-sm-9">@Model.FechaProgramada.ToString("dd/MM/yyyy")</dd>

        <dt class="col-sm-3">Fecha realizada</dt>
        <dd class="col-sm-9">@(Model.FechaRealizada is null ? "—" : Model.FechaRealizada.Value.ToString("dd/MM/yyyy HH:mm"))</dd>

        <dt class="col-sm-3">Personal asignado</dt>
        <dd class="col-sm-9">@(Model.PersonalAsignado ?? "—")</dd>

        <dt class="col-sm-3">Descripción</dt>
        <dd class="col-sm-9">@Model.Descripcion</dd>
    </dl>
</div>

<div class="d-flex gap-2 mb-4">
    @if (Model.Estado == EstadoMantenimiento.PENDIENTE)
    {
        <form asp-action="Iniciar" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-warning">Iniciar</button>
        </form>
        <form asp-action="Cancelar" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-outline-danger">Cancelar tarea</button>
        </form>
    }
    else if (Model.Estado == EstadoMantenimiento.EN_PROCESO)
    {
        <form asp-action="Completar" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-success">Completar</button>
        </form>
        <form asp-action="Cancelar" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-outline-danger">Cancelar tarea</button>
        </form>
    }
</div>

<a class="btn btn-link px-0" asp-action="Index">&laquo; Volver a mantenimiento</a>
