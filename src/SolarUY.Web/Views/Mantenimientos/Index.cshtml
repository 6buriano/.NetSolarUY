@model MantenimientosIndexViewModel
@{
    ViewData["Title"] = "Mantenimiento";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Mantenimiento</h1>
    <a class="btn btn-primary" asp-action="Crear" asp-route-panelId="@Model.PanelSolarId">Nueva tarea</a>
</div>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label class="form-label mb-0">Panel</label>
        <select name="panelId" class="form-select" onchange="this.form.submit()">
            <option value="">Todos los paneles</option>
            @foreach (var panel in Model.Paneles)
            {
                <option value="@panel.Id" selected="@(panel.Id == Model.PanelSolarId)">
                    @panel.CodigoPanel (@panel.Modelo)
                </option>
            }
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label mb-0">Estado</label>
        <select name="estado" class="form-select" onchange="this.form.submit()">
            <option value="">Todos los estados</option>
            @foreach (var valor in Enum.GetValues<EstadoMantenimiento>())
            {
                <option value="@valor" selected="@(Model.Estado == valor)">@valor</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <a class="btn btn-link" asp-action="Index">Limpiar</a>
    </div>
</form>

@if (Model.Tareas.Count == 0)
{
    <div class="alert alert-info">No hay tareas de mantenimiento con estos filtros.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Panel</th>
                    <th>Tipo</th>
                    <th>Fecha programada</th>
                    <th>Personal asignado</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tarea in Model.Tareas.OrderByDescending(t => t.FechaProgramada))
                {
                    <tr>
                        <td>@(tarea.PanelDescripcion ?? "—")</td>
                        <td>@tarea.Tipo</td>
                        <td>@tarea.FechaProgramada.ToString("dd/MM/yyyy")</td>
                        <td>@(tarea.PersonalAsignado ?? "—")</td>
                        <td><span class="badge @EstadoMantenimientoHelper.ClaseBadge(tarea.Estado)">@tarea.Estado</span></td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Detalle" asp-route-id="@tarea.Id">Ver</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
