@model MantenimientoFormViewModel
@{
    ViewData["Title"] = "Nueva tarea de mantenimiento";
}

<h1 class="h3 mb-3">Nueva tarea de mantenimiento</h1>

<div class="row">
    <div class="col-lg-8">
        <form asp-action="Crear" method="post" class="card card-body shadow-sm">
            <partial name="_Formulario" model="Model" />
            <div class="mt-2">
                <button type="submit" class="btn btn-primary">Guardar</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
