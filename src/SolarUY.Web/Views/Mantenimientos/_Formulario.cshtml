@model MantenimientoFormViewModel

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<input type="hidden" asp-for="Id" />

<div class="mb-3">
    <label asp-for="PanelSolarId" class="form-label"></label>
    <select asp-for="PanelSolarId" asp-items="@(new SelectList(Model.Paneles, nameof(PanelDto.Id), nameof(PanelDto.CodigoPanel)))"
            class="form-select" disabled="@(Model.Id is not null)"></select>
    @if (Model.Id is not null)
    {
        @* El panel no se puede cambiar al reprogramar: el select disabled no postea, así que va aparte. *@
        <input type="hidden" name="PanelSolarId" value="@Model.PanelSolarId" />
    }
    <span asp-validation-for="PanelSolarId" class="text-danger"></span>
</div>

<div class="row">
    <div class="col-md-4 mb-3">
        <label asp-for="Tipo" class="form-label"></label>
        <select asp-for="Tipo" asp-items="Html.GetEnumSelectList<TipoMantenimiento>()" class="form-select"
                disabled="@(Model.Id is not null)"></select>
        @if (Model.Id is not null)
        {
            <input type="hidden" name="Tipo" value="@Model.Tipo" />
        }
        <span asp-validation-for="Tipo" class="text-danger"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="FechaProgramada" class="form-label"></label>
        <input asp-for="FechaProgramada" class="form-control" />
        <span asp-validation-for="FechaProgramada" class="text-danger"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="PersonalAsignado" class="form-label"></label>
        <input asp-for="PersonalAsignado" class="form-control" placeholder="Opcional" />
        <span asp-validation-for="PersonalAsignado" class="text-danger"></span>
    </div>
</div>

<div class="mb-3">
    <label asp-for="Descripcion" class="form-label"></label>
    <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
    <span asp-validation-for="Descripcion" class="text-danger"></span>
</div>
