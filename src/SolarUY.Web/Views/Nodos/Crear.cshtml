@model NodoFormViewModel
@{
    ViewData["Title"] = "Nuevo nodo";
}

<h1 class="h3 mb-3">Nuevo nodo</h1>

@if (Model.Parques.Count == 0)
{
    <div class="alert alert-warning">
        Para crear un nodo primero tiene que existir al menos un parque solar.
        <a asp-controller="Parques" asp-action="Crear" class="alert-link">Crear un parque solar</a>.
    </div>
}
else
{
    <div class="row">
        <div class="col-lg-9">
            <form asp-action="Crear" method="post" class="card card-body shadow-sm">
                <partial name="_Formulario" model="Model" />
                <div class="mt-2">
                    @* Cuando el identificador no existe, el partial muestra los dos botones de la elección. *@
                    @if (Model.AvisoSensorInexistente is null)
                    {
                        <button type="submit" class="btn btn-primary">Guardar</button>
                    }
                    <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
