@model NodosIndexViewModel
@{
    ViewData["Title"] = "Nodos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Nodos</h1>
    <a class="btn btn-primary" asp-action="Crear" asp-route-parqueId="@Model.ParqueSolarId">Nuevo nodo</a>
</div>

<form method="get" asp-action="Index" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label asp-for="ParqueSolarId" class="form-label"></label>
        <select asp-for="ParqueSolarId" asp-items="@(new SelectList(Model.Parques, nameof(ParqueDto.Id), nameof(ParqueDto.Nombre)))" class="form-select">
            <option value="">Todos los parques</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Filtrar</button>
        <a class="btn btn-link" asp-action="Index">Limpiar</a>
    </div>
</form>

@if (Model.Nodos.Count == 0)
{
    <div class="alert alert-info">
        No hay nodos para mostrar. Creá uno con el botón <strong>Nuevo nodo</strong>.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Nodo</th>
                    <th>Parque</th>
                    <th>Ubicación dentro del parque</th>
                    <th>Inversor</th>
                    <th class="text-end">Paneles</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var nodo in Model.Nodos)
                {
                    <tr>
                        <td>@nodo.Nombre</td>
                        <td>@(nodo.ParqueNombre ?? "—")</td>
                        <td>@nodo.UbicacionDentroParque</td>
                        <td>
                            @nodo.Inversor.Modelo
                            <span class="text-muted">(@nodo.Inversor.NumeroSerie)</span>
                            <span class="badge text-bg-light">@nodo.Inversor.EficienciaConversion.ToString("0.##") %</span>
                        </td>
                        <td class="text-end">@nodo.CantidadPaneles</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Detalle" asp-route-id="@nodo.Id">Ver</a>
                            <a class="btn btn-sm btn-outline-primary" asp-action="Editar" asp-route-id="@nodo.Id">Editar</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Eliminar" asp-route-id="@nodo.Id">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
