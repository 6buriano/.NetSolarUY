@model NodoFormViewModel

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<input type="hidden" asp-for="Id" />

@if (Model.AvisoSensorInexistente is not null)
{
    <div class="alert alert-warning">
        <strong>@Model.AvisoSensorInexistente</strong>
        <div class="mt-2">
            Podés pedirle al simulador que empiece a emular ese sensor y asociarlo al nodo, o crear el
            nodo sin sensor. Sin sensor, el nodo queda cargado pero no recibe telemetría hasta que le
            cargues uno.
        </div>
        <div class="mt-3">
            <button type="submit" name="AccionArm" value="@NodoFormViewModel.AccionesArm.CrearEnHardware"
                    class="btn btn-warning">
                Crear el sensor <code>@Model.IdentificadorHardwareARM</code> en el simulador
            </button>
            <button type="submit" name="AccionArm" value="@NodoFormViewModel.AccionesArm.SinSensor"
                    class="btn btn-outline-secondary">
                Crear el nodo sin sensor
            </button>
        </div>
    </div>
}

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" placeholder="Nodo A" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="UbicacionDentroParque" class="form-label"></label>
        <input asp-for="UbicacionDentroParque" class="form-control" placeholder="Sector norte, fila 1" />
        <span asp-validation-for="UbicacionDentroParque" class="text-danger"></span>
    </div>
</div>

<div class="mb-3">
    <label asp-for="ParqueSolarId" class="form-label"></label>
    <select asp-for="ParqueSolarId" asp-items="@(new SelectList(Model.Parques, nameof(ParqueDto.Id), nameof(ParqueDto.Nombre)))" class="form-select"></select>
    <span asp-validation-for="ParqueSolarId" class="text-danger"></span>
</div>

<h2 class="h6 mt-4">Inversor del nodo</h2>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="InversorModelo" class="form-label"></label>
        <input asp-for="InversorModelo" class="form-control" placeholder="Huawei SUN2000-5KTL" />
        <span asp-validation-for="InversorModelo" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="InversorNumeroSerie" class="form-label"></label>
        <input asp-for="InversorNumeroSerie" class="form-control" placeholder="SN-000123" />
        <span asp-validation-for="InversorNumeroSerie" class="text-danger"></span>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="InversorEficienciaConversion" class="form-label"></label>
        <input asp-for="InversorEficienciaConversion" class="form-control" step="0.01" />
        <span asp-validation-for="InversorEficienciaConversion" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3 d-flex align-items-end">
        <div class="form-check">
            <input asp-for="InversorVolcadoRedActivo" class="form-check-input" />
            <label asp-for="InversorVolcadoRedActivo" class="form-check-label"></label>
        </div>
    </div>
</div>

<h2 class="h6 mt-4">Sensor ARM del nodo <span class="text-muted fw-normal">(opcional)</span></h2>
<p class="text-muted small">
    Si el identificador no existe todavía, el formulario te ofrece crearlo o cargar el nodo sin sensor.
</p>

<div class="row">
    <div class="col-md-4 mb-3">
        <label asp-for="IdentificadorHardwareARM" class="form-label"></label>
        <input asp-for="IdentificadorHardwareARM" class="form-control" placeholder="ARM-001" />
        <span asp-validation-for="IdentificadorHardwareARM" class="text-danger"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="SensorVersionFirmware" class="form-label"></label>
        <input asp-for="SensorVersionFirmware" class="form-control" placeholder="1.4.2" />
        <span asp-validation-for="SensorVersionFirmware" class="text-danger"></span>
    </div>
    <div class="col-md-4 mb-3 d-flex align-items-end">
        <div class="form-check">
            <input asp-for="SensorActivo" class="form-check-input" />
            <label asp-for="SensorActivo" class="form-check-label"></label>
        </div>
    </div>
</div>

<div class="mb-3">
    <label asp-for="SensorUrlBase" class="form-label"></label>
    <input asp-for="SensorUrlBase" class="form-control" placeholder="https://sensor.mi-parque.uy" />
    <span asp-validation-for="SensorUrlBase" class="text-danger"></span>
</div>
