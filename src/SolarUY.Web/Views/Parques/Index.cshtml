@model IReadOnlyList<ParqueDto>
@{
    ViewData["Title"] = "Parques solares";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Parques solares</h1>
    <a class="btn btn-primary" asp-action="Crear">Nuevo parque</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        Todavía no hay parques cargados. Empezá con el botón <strong>Nuevo parque</strong>.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Ubicación</th>
                    <th class="text-end">Capacidad (kW)</th>
                    <th class="text-end">Nodos</th>
                    <th class="text-end">Paneles</th>
                    <th class="text-end">Potencia paneles (kW)</th>
                    <th>Instalación</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var parque in Model)
                {
                    <tr>
                        <td>@parque.Nombre</td>
                        <td>@parque.Ubicacion</td>
                        <td class="text-end">@parque.CapacidadInstaladaKW.ToString("0.##")</td>
                        <td class="text-end">@parque.CantidadNodos</td>
                        <td class="text-end">@parque.CantidadPaneles</td>
                        <td class="text-end">@parque.PotenciaNominalPanelesKW.ToString("0.##")</td>
                        <td>@parque.FechaInstalacion.ToString("dd/MM/yyyy")</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Detalle" asp-route-id="@parque.Id">Ver</a>
                            <a class="btn btn-sm btn-outline-primary" asp-action="Editar" asp-route-id="@parque.Id">Editar</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Eliminar" asp-route-id="@parque.Id">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
