@model ParqueDto
@{
    ViewData["Title"] = "Eliminar parque solar";
}

<h1 class="h3 mb-3">Eliminar parque solar</h1>

<div class="alert alert-warning">
    ¿Confirmás que querés eliminar el parque <strong>@Model.Nombre</strong> (@Model.Ubicacion)?
    Esta acción no se puede deshacer.
</div>

@if (Model.CantidadNodos > 0)
{
    <div class="alert alert-danger">
        El parque tiene @Model.CantidadNodos nodo(s) asociado(s). El sistema va a rechazar la eliminación
        hasta que elimines esos nodos primero.
    </div>
}

<form asp-action="Eliminar" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Sí, eliminar</button>
    <a class="btn btn-outline-secondary" asp-action="Detalle" asp-route-id="@Model.Id">Cancelar</a>
</form>
