@model ParqueDetalleViewModel
@{
    ViewData["Title"] = Model.Parque.Nombre;
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h1 class="h3 mb-0">@Model.Parque.Nombre</h1>
        <p class="text-muted mb-0">@Model.Parque.Ubicacion</p>
    </div>
    <div class="text-nowrap">
        <a class="btn btn-primary" asp-controller="Nodos" asp-action="Crear" asp-route-parqueId="@Model.Parque.Id">Nuevo nodo</a>
        <a class="btn btn-outline-primary" asp-action="Editar" asp-route-id="@Model.Parque.Id">Editar</a>
        <a class="btn btn-outline-danger" asp-action="Eliminar" asp-route-id="@Model.Parque.Id">Eliminar</a>
    </div>
</div>

<div class="card card-body shadow-sm mb-4">
    <dl class="row mb-0">
        <dt class="col-sm-3">Capacidad instalada</dt>
        <dd class="col-sm-9">@Model.Parque.CapacidadInstaladaKW.ToString("0.##") kW</dd>

        <dt class="col-sm-3">Fecha de instalación</dt>
        <dd class="col-sm-9">@Model.Parque.FechaInstalacion.ToString("dd/MM/yyyy")</dd>

        <dt class="col-sm-3">Paneles cargados</dt>
        <dd class="col-sm-9">
            @Model.Parque.CantidadPaneles
            (@Model.Parque.PotenciaNominalPanelesKW.ToString("0.##") kW nominales)
        </dd>
    </dl>
</div>

<h2 class="h5">Nodos (@Model.Nodos.Count)</h2>

@if (Model.Nodos.Count == 0)
{
    <div class="alert alert-info">Este parque todavía no tiene nodos.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Nodo</th>
                    <th>Ubicación</th>
                    <th>Inversor</th>
                    <th class="text-end">Paneles</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var nodo in Model.Nodos)
                {
                    <tr>
                        <td>@nodo.Nombre</td>
                        <td>@nodo.UbicacionDentroParque</td>
                        <td>@nodo.Inversor.Modelo <span class="text-muted">(@nodo.Inversor.NumeroSerie)</span></td>
                        <td class="text-end">@nodo.CantidadPaneles</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-controller="Nodos" asp-action="Detalle" asp-route-id="@nodo.Id">Ver</a>
                            <a class="btn btn-sm btn-outline-primary" asp-controller="Nodos" asp-action="Editar" asp-route-id="@nodo.Id">Editar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<a class="btn btn-link px-0" asp-action="Index">&laquo; Volver a parques</a>
