{
  // En desarrollo la cadena de conexión vive en appsettings.Development.json.
  // En producción se define por variable de entorno: ConnectionStrings__SolarUY.
  "Colector": {
    // Apagalo en todos los nodos menos uno si la web corre en varias instancias,
    // así no se duplican las lecturas.
    "Habilitado": true,
    "IntervaloSegundos": 5,
    // Purga de la telemetría vieja: el colector escribe ~260.000 filas por día, así que sin
    // retención la tabla (y el disco del servidor) crecen sin límite.
    "RetencionHabilitada": true,
    "RetencionDias": 90,
    "IntervaloRetencionHoras": 6
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      // El colector escribe cada 5 segundos: sin esto el log se llena de SQL y de HTTP.
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  }
}
