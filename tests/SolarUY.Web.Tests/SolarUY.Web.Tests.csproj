<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- Alineado con Infrastructure (ver CodeQuality.Tests): evita el aviso MSB3277 de versiones en conflicto. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.20" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Los controladores usan tipos de ASP.NET Core: mismas versiones que la web (como en CodeQuality.Tests). -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SolarUY.Domain\SolarUY.Domain.csproj" />
    <ProjectReference Include="..\..\src\SolarUY.Application\SolarUY.Application.csproj" />
    <ProjectReference Include="..\..\src\SolarUY.Web\SolarUY.Web.csproj" />
  </ItemGroup>

</Project>
