# Copiar a .env (ese archivo no se versiona) y ajustar si hace falta:
#   Copy-Item .env.example .env
#
# Los valores de MySQL son los del volumen de desarrollo que ya existe en esta máquina,
# así que el .env tal cual está apunta a la base que ya tenés cargada.

# ---- MySQL ---------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=solareuy
MYSQL_USER=solareuy
MYSQL_PASSWORD=solareuy

# ---- Simulador -----------------------------------------------------------------------
# URL del simulador desplegado. La usa la web (Simulador:UrlBase: pantalla de Diagnóstico
# y verificación del sensor al dar de alta un nodo).
#
# HTTP y no HTTPS: ese host presenta un certificado a nombre de otro dominio, así que la
# validación TLS falla desde .NET. Por HTTP responde bien y es la URL que usamos.
#
# OJO: esto NO cambia de dónde lee el colector. El colector consulta la url_base de cada
# sensor, que está en la base: para cambiar de simulador hay que actualizar ese dato
# (ver Documentacion/actualizacion-sin-cortes.md).
#
# Para trabajar sin internet, el respaldo local:
#   docker compose --profile simulador-local up -d
#   y acá poner SIMULADOR_URL=http://sensor-simulator:8080
SIMULADOR_URL=http://simulador.fabriq.uy

# ---- Red -----------------------------------------------------------------------------
# Subred fija de la red de Docker. Tiene que coincidir con ReverseProxy__KnownNetwork,
# que es la única red de la que la web acepta cabeceras X-Forwarded-* (la de nginx).
# 10.201.x queda fuera del pool que Docker reparte solo (172.18-172.31) y de las redes de
# esta máquina (192.168.1.x, 192.168.56.x, 192.168.128.x y el 172.30 de WSL).
DOCKER_SUBNET=10.201.0.0/16

# ---- Imágenes ------------------------------------------------------------------------
# nginx con versión fija (no latest), como el resto de las imágenes.
NGINX_IMAGE=nginx:1.28.0-alpine

# Etiqueta de las imágenes propias (solaruy-web, solaruy-collector).
# Para poder volver atrás antes de cada actualización:
#   docker tag solaruy-web:latest solaruy-web:anterior
SOLARUY_TAG=latest
